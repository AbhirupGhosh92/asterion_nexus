#!/usr/bin/env bash
# Blocks a commit that would add secrets. Enable with:
#     git config core.hooksPath .githooks     (or ./scripts/install-hooks.sh)
#
# Bypass once with `git commit --no-verify` — CI runs the same scan over the
# whole tree, so a bypass is visible rather than silent.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/scan_secrets.py" || exit 1
