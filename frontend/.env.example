# Copy to .env.local and fill from Firebase Console → Project settings →
# Your apps → Web app config. These are public client identifiers, not
# secrets — but keep .env.local out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
