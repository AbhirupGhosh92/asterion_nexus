# Copy to .env and fill in. NEVER commit .env.

# --- Model provider: vertexai (Gemini) | ollama | mock (no AI needed) ---
LLM_PROVIDER=vertexai
GCP_PROJECT=your-project-id
GCP_REGION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Offline/dev alternatives:
# LLM_PROVIDER=mock
# AUTH_DISABLED=1                     # skip Firebase verification (dev only)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

ALLOWED_ORIGINS=http://localhost:5173

# --- Admin control plane: comma-separated email allowlist ---
ADMIN_EMAILS=you@example.com

# --- Firebase Storage bucket for uploads / generated images ---
STORAGE_BUCKET=your-project.firebasestorage.app

# --- Dify engine (local docker; leave unset to disable agents) ---
DIFY_BASE_URL=http://localhost:8090
DIFY_ADMIN_EMAIL=admin@nexus.local
DIFY_ADMIN_PASSWORD=change-me

# Dify engine lifecycle control (admin panel → ENGINE tab).
# Local docker: point at the compose directory.
DIFY_COMPOSE_DIR=/absolute/path/to/infra/dify/docker
# Cloud VM: set by Terraform when WITH_DIFY=true (do not set by hand).
# DIFY_VM_NAME=dify-engine
# DIFY_VM_ZONE=us-central1-a
